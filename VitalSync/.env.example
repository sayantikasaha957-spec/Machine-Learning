# Environment Configuration for VitalSync

# Backend
PROJECT_NAME="VitalSync"
API_V1_STR="/api/v1"
SECRET_KEY="vitalsync-secret-key-change-in-production-use-strong-entropy"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Database
DATABASE_URL="sqlite:///./vitalsync.db"

# Server
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
ENVIRONMENT="development"
DEBUG=True

# Frontend
VITE_API_URL="http://localhost:8000"
VITE_WS_URL="ws://localhost:8000/ws"
